{
  "name": "stephen-wang-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Professional developer portfolio for Stephen Wang - Full-Stack Developer.",
  "scripts": {
    "predev": "node scripts/sync-resume.mjs",
    "dev": "node scripts/dev.mjs",
    "resume:sync": "node scripts/sync-resume.mjs",
    "servers": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tooling/servers.ps1 status",
    "servers:guard": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tooling/servers.ps1 guard",
    "servers:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tooling/servers.ps1 stop -Kind node -Force",
    "dev:next": "next dev",
    "prebuild": "node scripts/sync-resume.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
