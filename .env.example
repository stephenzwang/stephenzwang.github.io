# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored; `.env.example` is safe to commit.
#
# The contact section is a plain mailto: link — there is no contact form and no
# captcha, so the only variable the site needs is the optional base path.

# --- Deployment -------------------------------------------------------------
# GitHub project page only (https://<user>.github.io/<repo>/). Empty = user page.
NEXT_PUBLIC_BASE_PATH=
